---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import IngredientCard from '../components/IngredientCard.astro';
import IngredientItem from '../components/IngredientItem.astro';
import StepCard from '../components/StepCard.astro';
import RetailerCard from '../components/RetailerCard.astro';
import Button from '../components/Button.astro';
import Tip from '../components/Tip.astro';
import CTASection from '../components/CTASection.astro';
import Hero from '../components/Hero.astro';
import { mdiMapMarker, mdiStore, mdiBasket } from '@mdi/js';
---

<Layout title="Mein Ginger - Der Ingwer-Mehrfruchtsaft mit Kick!" url="https://meinginger.de">
    <Hero page="index" headline="Mein Ginger" tagline="FEEL THE BOOST!" subtitle="Hausgemachter Ingwer-Mehrfruchtsaft, mit Wumms und kräftig im Geschmack">
        <div class="cta-buttons" role="region" aria-label="Aktionsschaltflächen">
            <Button
                href="https://besseressen-ka.de/produkte/mein-ginger-ingwer-mehrfruchtsaft/"
                ariaLabel="Mein Ginger jetzt im besser essen Online-Shop kaufen"
                type="external"
            >
                Jetzt kaufen
            </Button>
            <Button href="#about" ariaLabel="Mehr über Mein Ginger erfahren" variant="secondary"> Mehr erfahren </Button>
        </div>
    </Hero>

    <section id="about" class="content-section about" aria-labelledby="about-heading">
        <div class="content-section__content">
            <h2 id="about-heading">Was ist Mein Ginger?</h2>
            <p>
                "Mein Ginger" ist ein hausgemachter Mehrfruchtsaft aus feinen Zutaten, der die Kraft von viel frischem Ingwer vereint. Im Original eine perfekte
                Mischung aus Apfel, Orange, Ananas, Passionsfrucht, Mango und Banane – ein Genuss für Körper und Seele.
            </p>
            <p>
                Neben der Original-Rezeptur bieten wir auch weitere leckere Varianten an, wie "Mein Ginger Beere" mit fruchtiger Beeren-Note und "Mein Ginger
                Sanddorn" mit exotischer Sanddorn-Note. Wir empfehlen, den Saft im Verhältnis 1:2 mit heißem oder kaltem Wasser zu mischen, um das volle Aroma
                zu genießen. Zum Direkttrinken haben wir "Mein Ginger Spirit", fix und fertig im besten Mischverhältnis.
            </p>
            <div class="ingredients-highlight mobile-scroll-slider" role="region" aria-label="Hauptmerkmale von Mein Ginger">
                <IngredientCard
                    title={'Natürliche Zutaten von Mein Ginger "Original"'}
                    description="Apfelsaft* (66%), Ananas-, Orangen- und Passionsfruchtsaft, Mango- und Bananenmark mit 5% Ingwer*"
                />
                <IngredientCard
                    title="Energie & Gesundheit"
                    description="Die natürliche Kraft des Ingwers kombiniert mit wertvollen Früchten für deinen täglichen Boost"
                />
                <IngredientCard
                    title="Nachhaltig"
                    description="Einige Zutaten stammen aus alternativem, nachhaltigem Anbau. Außerdem bekommst du Mein Ginger ausschließlich in Pfandflaschen – weniger Müll für den Planeten"
                />
            </div>
        </div>
    </section>

    {/* Ingredients Section */}
    <section id="ingredients" class="content-section ingredients" aria-labelledby="ingredients-heading">
        <div class="content-section__content">
            <h2 id="ingredients-heading">Zutaten von Mein Ginger</h2>
            <p>70+% Bio und 100% natürliche Zutaten für das unverfälschte Geschmackserlebnis</p>
            <p>
                Zutaten und Prozentangaben beziehen sich auf die Sorte Mein Ginger Original. Die genauen Zutaten all unserer Varianten findest du auf den
                <a href="#variants" class="text-primary hover:text-primary-hover" title="Zu den Mein Ginger Varianten">Produktdetailseiten im Shop</a>.
            </p>

            <p class="sr-only">Liste mit den wichtigsten Zutaten im Mein Ginger Ingwer-Mehrfruchtsaft</p>

            <IngredientItem
                isHighlight={true}
                label="5%"
                title="Frisch geraspelter Bio-Ingwer* **"
                description="Die Power-Zutat für den besonderen Kick"
                imageLeft="/images/ingredients/ingwer-cut-transparent.webp"
                imageRight="/images/ingredients/ingwer-raspel-cut-transparent.webp"
            />
            <div class="ingredients-list mobile-scroll-slider" role="list">
                <IngredientItem
                    image="/images/ingredients/apfel-cut-transparent.webp"
                    title="Bio-Apfelsaft*"
                    description="Beste Saftqualität ist die Basis unseres Mehrfruchtsafts"
                />
                <IngredientItem
                    image="/images/ingredients/orange-ananas-passionsfrucht-cut-transparent.webp"
                    title="Orangen-, Ananas- & Passionsfruchtsaft"
                    description="Für exotisches Aroma und Frische"
                />
                <IngredientItem
                    image="/images/ingredients/mango-banane-cut-transparent.webp"
                    title="Mango- und Bananenmark**"
                    description="Für cremige Textur und natürliche Süße"
                />
                <IngredientItem
                    image="/images/ingredients/bluete-sanddorn-beere-cut-transparent.webp"
                    title="Sanddorn bzw. versch. Beeren und Blüten"
                    description="in unseren anderen Varianten."
                />
            </div>
            <small class="block mt-8">
                ** Nach langer Standzeit kann sich Ingwer und Fruchtmark am Flaschenboden absetzen. Vor dem weiteren Verbrauch kurz schütteln!
            </small>
        </div>
    </section>

    <section class="content-section how-to-use" aria-labelledby="how-to-heading">
        <div class="content-section__content">
            <h2 id="how-to-heading">So genießt du Mein Ginger</h2>
            <p class="sr-only">Anleitung zur Zubereitung und zum Genuss von Mein Ginger</p>
            <div class="preparation" role="list" aria-label="Zubereitungsschritte">
                <StepCard number={1} title="Mische 1 Teil Mein Ginger Saft" />
                <StepCard number={2} title="Mit 2 Teilen heißem oder kaltem Wasser" />
                <StepCard number={3} title="Umrühren und genießen!" />
            </div>
            <Tip text="Entdecke leckere Rezeptideen gleich hier oder im Rezeptflyer">
                <Button href="/rezepte" ariaLabel="Zu unseren Rezepteideen mit Mein Ginger">Rezeptideen</Button>
            </Tip>
        </div>
    </section>

    <section class="content-section" aria-labelledby="how-to-heading">
        <div class="content-section__content">
            <div class="mood" style="align-items:stretch" aria-label="Mein Ginger Flaschenfotos">
                <img
                    style="object-fit: cover;border-radius: 8px;"
                    src="/images/meinginger-shot-1.webp"
                    alt="Eine Flasche Mein Ginger Original mit Ingwer, Äpfeln, Orangen und Mango nebendran"
                />
                <img
                    style="object-fit: cover;border-radius: 8px;"
                    src="/images/meingingerbeere-shot-1.webp"
                    alt="Eine Flasche Mein Ginger Beere mit Beeren und Passionsfrucht"
                />
            </div>
        </div>
    </section>

    {/* Product Variants Section */}
    <section id="variants" class="content-section variants" aria-labelledby="variants-heading">
        <div class="content-section__content">
            <h2 id="variants-heading">Alle Varianten von Mein Ginger</h2>
            <p class="sr-only">Übersicht aller verfügbaren Mein Ginger Sorten und Varianten</p>
            <div class="variants-grid mobile-scroll-slider">
                <ProductCard
                    image="/images/meinginger-original-web.webp"
                    imageAlt="Mein Ginger Original - Ingwer-Mehrfruchtsaft mit Apfel, frischem Ingwer, Orange, Ananas, Passionsfrucht, Mango und Banane"
                    title="Mein Ginger Original"
                    description="Der Klassiker mit viel frischem Ingwer und tropischen Früchten"
                    price="6,40 € (0,5l)"
                    priceLabel="Preis 6,40 Euro für 0,5 Liter"
                    buttonUrl="https://besseressen-ka.de/shop/mein-ginger-ingwer-mehrfruchtsaft/mein-ginger-original/"
                    buttonAriaLabel="Zu den Produktdetails von Mein Ginger Original in unserem besser essen Online-Shop"
                    buttonVariant="mg-original"
                />
                <ProductCard
                    image="/images/meinginger-beere-web.webp"
                    imageAlt="Mein Ginger Beere - Ingwersaft mit verschiedenen Beeren und Passionsfrucht"
                    title="Mein Ginger Beere"
                    description="Die fruchtige Variante mit Beeren-Note"
                    price="6,40 € (0,5l)"
                    priceLabel="Preis 6,40 Euro für 0,5 Liter"
                    buttonUrl="https://besseressen-ka.de/shop/mein-ginger-ingwer-mehrfruchtsaft/mein-ginger-beere/"
                    buttonAriaLabel="Zu den Produktdetails von Mein Ginger Beere in unserem besser essen Online-Shop"
                    buttonVariant="mg-beere"
                />
                <ProductCard
                    image="/images/meinginger-sanddorn-web.webp"
                    imageAlt="Mein Ginger Sanddorn - Ingwersaft mit kraftvollem Sanddorn"
                    title="Mein Ginger Sanddorn"
                    description="Mit der kraftvollen Sanddorn-Komponente"
                    price="6,40 € (0,5l)"
                    priceLabel="Preis 6,40 Euro für 0,5 Liter"
                    buttonUrl="https://besseressen-ka.de/shop/mein-ginger-ingwer-mehrfruchtsaft/mein-ginger-sanddorn/"
                    buttonAriaLabel="Zu den Produktdetails von Mein Ginger Sanddorn in unserem besser essen Online-Shop"
                    buttonVariant="mg-sanddorn"
                />
                <ProductCard
                    image="/images/meinginger-spirit-web.webp"
                    imageAlt="Mein Ginger Spirit - Fix und fertig gemischt zum direkt Trinken"
                    title="Mein Ginger Spirit"
                    description="Die konzentrierte Kraft, fix und fertig gemischt zum direkt Trinken und geboostet werden!"
                    price="4,40 € (0,3l)"
                    priceLabel="Preis 4,40 Euro für 0,3 Liter"
                    buttonUrl="https://besseressen-ka.de/shop/mein-ginger-ingwer-mehrfruchtsaft/mein-ginger-spirit/"
                    buttonAriaLabel="Zu den Produktdetails von Mein Ginger Spirit in unserem besser essen Online-Shop"
                    buttonVariant="mg-spirit"
                />
            </div>
        </div>
    </section>

    <CTASection
        headline="Bereit für dein Mein Ginger-Abenteuer?"
        text="Entdecke jetzt alle Varianten von Mein Ginger im Shop und finde deine Lieblings-Sorte"
        cta={{
            href: 'https://besseressen-ka.de/produkte/mein-ginger-ingwer-mehrfruchtsaft/',
            ariaLabel: 'Zum unserem besser essen Online Shop - Mein Ginger kaufen',
            size: 'large',
            type: 'external',
            text: 'Zum Shop'
        }}
    />

    {/* Retailers Section */}
    <section id="retailers" class="content-section retailers" aria-labelledby="retailers-heading">
        <div class="content-section__content">
            <h2 id="retailers-heading">Wo findest du Mein Ginger?</h2>
            <p>Mein Ginger ist bei bei uns in Durlach erhältlich, ansonsten kannst du Mein Ginger auch über unseren Onlineshop kaufen.</p>
            <div class="retailers-grid retailers-grid" role="list">
                <RetailerCard
                    title="Online Shop"
                    description="Bestelle bequem von zuhause über unseren besser essen Onlineshop"
                    buttonText="Zu unserem Shop"
                    buttonUrl="https://besseressen-ka.de/produkte/mein-ginger-ingwer-mehrfruchtsaft/"
                    buttonAriaLabel="Zum Online-Shop - Mein Ginger kaufen"
                    iconSVG={mdiBasket}
                />
                <RetailerCard
                    title="Stammgeschäft"
                    html="Kleine Feinschmeckerei<br />Amthausstraße 7<br />76227 Karlsruhe-Durlach"
                    buttonText="Routenplanung"
                    buttonIconSVG={mdiMapMarker}
                    buttonUrl="https://www.google.com/maps/dir/?api=1&destination=Kleine+Feinschmeckerei,+Amthausstrasse+7,+76227+Karlsruhe,+DE"
                    buttonAriaLabel="Zur Routenplanung von Google Maps"
                    iconSVG={mdiStore}
                />
                {/*<RetailerCard title="🗺️ Weitere Händler" description="Finde einen Händler in deiner Nähe auf unserer Verkaufsstellenkarte" />*/}
            </div>
        </div>
    </section>
</Layout>

<style>
    .cta-buttons {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
    }

    .ingredients-highlight {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    /* Ingredients Section */

    .ingredients-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 2rem;
    }

    /* How to Use Section */
    .how-to-use {
        background: linear-gradient(135deg, #faf8f3 0%, #f5f0e8 100%);
    }

    .preparation {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 2rem;
        margin: 2rem 0;
    }

    .mood {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 2rem;
        align-items: stretch;
    }

    /* Variants Section */

    .variants-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
    }

    .variants-additional {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
    }

    .retailers {
        background-color: #faf8f3;
    }

    .retailers p {
        text-align: center;
        font-size: 1.1rem;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
    }

    .retailers-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 2rem;
    }

    /* Responsive Design */
    @media (max-width: 560px) {
        .cta-buttons {
            flex-direction: column;
        }
    }
</style>
